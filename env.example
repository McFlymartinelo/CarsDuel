# Copier vers .env.local
# PostgreSQL local (docker-compose.yml) ou votre propre serveur. Le rôle doit être propriétaire des tables.
DATABASE_URL=postgres://carsduel:carsduel@localhost:5432/carsduel

# Nombre de reverse proxies de confiance devant l'application (x-forwarded-for).
# 0 ou absent : l'en-tête n'est pas fiable, l'IP de rate limiting vaut "unknown".
# Derrière un seul Nginx/Caddy/Traefik : TRUSTED_PROXY_COUNT=1
# TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# OTP / authentification
# ---------------------------------------------------------------------------
# Obligatoires en production : 32 caractères minimum, valeurs de démonstration refusées.
# En développement, un repli local documenté est utilisé si elles sont absentes.
# Générer par exemple : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_OTP_PEPPER=
# AUTH_OTP_JWT_SECRET=

# Cooldown de renvoi d'un code (millisecondes). Défaut : 30000.
# AUTH_OTP_RESEND_MS=30000

# Durée de vie d'un code (millisecondes). Défaut : 600000 (10 minutes).
# AUTH_OTP_TTL_MS=600000

# 1 = exposer devOtp dans la réponse hors production (jamais en production).
# AUTH_OTP_ECHO=0

# 0 = pause de la vérification par code (connexion directe après le mot de passe,
# comptes marqués vérifiés et kit de départ versé immédiatement). Défaut : 1.
# AUTH_OTP_ENABLED=1

# Plafonds de rate limiting (valeurs par défaut indiquées).
# AUTH_RATE_LIMIT_MAX=20              # connexions / IP / 15 min
# AUTH_LOGIN_FAIL_MAX=5              # échecs / e-mail / 15 min
# AUTH_SIGNUP_RATE_LIMIT_MAX=5       # inscriptions / IP / 1 h
# AUTH_OTP_RATE_LIMIT_MAX=8          # envois OTP / IP / 15 min
# AUTH_OTP_VERIFY_RATE_LIMIT_MAX=20  # vérifications OTP / IP / 15 min

# ---------------------------------------------------------------------------
# SMTP (codes OTP)
# ---------------------------------------------------------------------------
# Option 1 : URL complète
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# Option 2 : paramètres séparés
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=

# Expéditeur (SMTP_FROM prioritaire, sinon MAIL_FROM).
# SMTP_FROM=CarsDuel <noreply@carsduel.app>
# MAIL_FROM=CarsDuel <noreply@carsduel.app>

# Mailpit en local : SMTP_HOST=localhost, SMTP_PORT=1025, pas d'authentification.
